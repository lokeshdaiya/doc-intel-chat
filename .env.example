# Copy this file to .env.local and fill in the values.

# ── Database ──────────────────────────────────────────────────────────────
# Matches docker-compose.yml. Any PostgreSQL 14+ works (Azure Database for PostgreSQL, Neon, Supabase...).
DATABASE_URL=postgres://docintel:docintel@localhost:5432/docintel

# ── Extraction service ────────────────────────────────────────────────────
# azure | local | auto (default: Azure when configured, otherwise local).
# The Settings page in the app can override this.
DOCUMENT_EXTRACTOR=auto

# ── Local extractor (free, no key) ────────────────────────────────────────
# Tesseract OCR languages joined with +, e.g. eng, eng+hin, eng+deu
LOCAL_OCR_LANGUAGES=eng
# Where downloaded OCR language data is cached
OCR_CACHE_DIR=.cache/tesseract

# ── Azure AI Document Intelligence (optional if you use the local extractor) ──
# Azure portal → your Document Intelligence resource → Keys and Endpoint
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# prebuilt-layout (default: text, tables, key-value pairs), prebuilt-read, prebuilt-invoice,
# prebuilt-receipt, prebuilt-idDocument, or a custom model id.
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout

# ── Uploads ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
# The Azure free tier (F0) only accepts files up to 4 MB and analyzes the first 2 pages.
MAX_UPLOAD_MB=20

# ── Chat providers (configure one or more) ────────────────────────────────
# Which configured provider the chat uses by default:
# openrouter | azure | ollama | groq | google | anthropic | openai
DEFAULT_CHAT_PROVIDER=openrouter

# OpenRouter — https://openrouter.ai/keys (models ending in :free are free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Azure OpenAI — set RESOURCE_NAME (https://<name>.openai.azure.com) or BASE_URL
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=

# Ollama — free, runs locally (https://ollama.com). Leave empty to disable.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# Groq — free tier, https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — free tier, https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
